# ============================================================
# Bug Auto-Fix MVP 环境变量示例
# 使用方式：
#   cp .env.example .env
#   填写真实值后再启动；.env 不要提交到仓库。
# 生成随机密钥：
#   openssl rand -hex 32
# ============================================================

# PostgreSQL 密码。
# docker compose 会用它启动数据库，并拼出 DATABASE_URL。
# 如果密码包含 @ : / 等字符，需要 URL 编码后再放进 DATABASE_URL。
POSTGRES_PASSWORD=change-me

# 管理接口 Bearer Token。
# 用于 /api/intake、/api/tasks/{id}/retry、/api/tasks/{id}/cancel、/api/admin/pause。
# 未设置时本地开发会跳过鉴权；生产环境必须设置。
AUTOFIX_ADMIN_TOKEN=change-me-admin

# 审批链接签名密钥。
# 用于生成/校验 PLAN、RESULT、MERGE 的一次性审批 Token。
# 轮换后，之前发出的审批链接会立即失效。
AUTOFIX_APPROVAL_SECRET=change-me-approval

# GitLab Bot Token。
# scope 至少包含：api、write_repository。
# 项目角色：Developer 以上；合并受保护分支通常需要 Maintainer，或允许 Developer 合并。
# 该 Token 用于创建 MR、合并 MR、评论 Issue、读取分支。
GITLAB_TOKEN=

# 来源系统只读 Token。
# 当前实现只支持 GitLab Issues；可以与 GITLAB_TOKEN 相同。
# 如果单独配置，建议只给 read_api / read_repository 权限。
# Poller 在未设置时会回退使用 GITLAB_TOKEN。
SOURCE_TOKEN=

# 飞书自定义机器人 Webhook（可选）。
# 只用于发送“审批链接”通知，不处理卡片回调。
# 留空时审批链接只写入日志。
FEISHU_WEBHOOK=

# 分析模型 API Key。
# 只用于分析阶段；编码模型由 OpenCode 自己管理。
ANTHROPIC_API_KEY=

# 分析模型 Base URL（可选）。
# 留空时使用官方地址；私有化网关或代理时填写兼容 Anthropic Messages API 的地址。
ANTHROPIC_BASE_URL=

# 可选：覆盖 config.yaml 中的 app.database_url。
# docker compose 会自动注入；本地直接运行 API/Worker 时可以手动设置。
# DATABASE_URL=postgresql+asyncpg://autofix:change-me@localhost:5432/autofix

# 可选：配置文件路径。
# 默认读取 config.yaml；不存在时回退 config.example.yaml。
# AUTOFIX_CONFIG=config.yaml

# 可选：仅本地临时开发使用。
# 设为 1 时，API/Worker/Poller 启动会用 create_all 自动建表；
# 生产/验证环境请保持未设置，并先执行 `alembic upgrade head`。
# AUTOFIX_INIT_DB=0

# 可选：Runner/Agent 出口代理。
# 用于限制 OpenCode 和测试命令只能访问模型、GitLab、包仓库等白名单地址。
# HTTPS_PROXY=http://proxy.internal:8080